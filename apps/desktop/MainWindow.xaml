<Window x:Class="DevManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevManager Desktop"
        Height="720"
        Width="1200"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Background="#111827">
    <Grid Margin="24">
        <Border CornerRadius="16"
                Background="#1F2937"
                BorderBrush="#374151"
                BorderThickness="1"
                Padding="24">
            <StackPanel>
                <TextBlock Text="DevManager Desktop"
                           Foreground="#F9FAFB"
                           FontSize="34"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0"
                           Text="Connect your account to continue."
                           Foreground="#D1D5DB"
                           FontSize="16" />
                <Button Margin="0,20,0,0"
                        Width="180"
                        Height="44"
                        Click="LoginButton_Click"
                        Content="Login"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Cursor="Hand" />
                <TextBlock Margin="0,16,0,0"
                           Text="Browser login will open your live app. After approval, you will be redirected back here."
                           Foreground="#9CA3AF"
                           FontSize="14"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StatusTextBlock"
                           Margin="0,14,0,0"
                           Foreground="#D1D5DB"
                           FontSize="14"
                           Text="Status: Not logged in" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
