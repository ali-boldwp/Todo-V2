<Window x:Class="DevManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DevManager Desktop"
        Height="820"
        Width="1360"
        MinHeight="720"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#1E1F22"
        FontFamily="Segoe UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="BrushTitleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2E4E58" Offset="0" />
            <GradientStop Color="#283641" Offset="0.38" />
            <GradientStop Color="#222A34" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BrushBgMain" Color="#1E1F22" />
        <SolidColorBrush x:Key="BrushTitle" Color="#252A31" />
        <SolidColorBrush x:Key="BrushSidebar" Color="#22262B" />
        <SolidColorBrush x:Key="BrushPanel" Color="#252A31" />
        <SolidColorBrush x:Key="BrushBorder" Color="#32363D" />
        <SolidColorBrush x:Key="BrushText" Color="#D3D8DE" />
        <SolidColorBrush x:Key="BrushMuted" Color="#8B949E" />
        <SolidColorBrush x:Key="BrushAccent" Color="#39C1D6" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2C313C" />
                    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1F2329" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2F37" />
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#313846" />
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="188" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="{StaticResource BrushTitleGradient}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="8,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Menu" Foreground="{StaticResource BrushMuted}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource BrushAccent}">
                        <TextBlock Text="TV" Foreground="#0F1722" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Todo V2" Margin="8,0,0,0" Foreground="{StaticResource BrushText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="main" Margin="10,0,0,0" Foreground="{StaticResource BrushMuted}" FontSize="10.5" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4" Padding="10,3" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Background="#2B3039">
                    <TextBlock Text="Current File" Foreground="#A7B5C7" FontSize="10.5" FontWeight="SemiBold" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="R" Foreground="{StaticResource BrushMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="S" Foreground="{StaticResource BrushMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Width="30" Height="22" Margin="1,0" Content="-" Click="MinimizeButton_Click" />
                    <Button Width="30" Height="22" Margin="1,0" Content="[ ]" Click="MaximizeRestoreButton_Click" />
                    <Button Width="30" Height="22" Margin="1,0" Content="X" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,10,0,10" HorizontalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource BrushAccent}" Margin="0,0,0,10">
                    <TextBlock Text="D" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Width="33" Height="33" Margin="0,3" CornerRadius="8" Background="#2B3A4B"><TextBlock Text="H" Foreground="#75D8E8" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Width="33" Height="33" Margin="0,3" CornerRadius="8" Background="#273343"><TextBlock Text="P" Foreground="#8A99AD" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <Border Width="33" Height="33" Margin="0,3" CornerRadius="8" Background="#273343"><TextBlock Text="T" Foreground="#8A99AD" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BrushSidebar}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <StackPanel Margin="12,10,12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Commit" Foreground="{StaticResource BrushText}" FontSize="13" FontWeight="SemiBold" />
                        <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="5" Background="#2D3138" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <TextBlock Text="Commit" Foreground="{StaticResource BrushMuted}" FontSize="11" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,10,10,10">
                    <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                        <TextBlock Text="Changed Files" Foreground="{StaticResource BrushMuted}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <ListBox x:Name="FileListBox"
                             Margin="0,8,0,0"
                             SelectionChanged="FileListBox_SelectionChanged"
                             Background="{StaticResource BrushBgMain}"
                             BorderBrush="{StaticResource BrushBorder}"
                             Foreground="{StaticResource BrushText}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="10">
                    <TextBlock Text="{Binding ElementName=CurrentFileText, Path=Text}" Foreground="{StaticResource BrushMuted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="2" Background="{StaticResource BrushPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1F2329" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="8,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Border Height="28" CornerRadius="6,6,0,0" Background="#2B3038" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,1,1,0" Padding="10,0" Margin="0,0,4,0">
                            <TextBlock x:Name="CurrentFileText" Text="editor-ready.ts" Foreground="{StaticResource BrushText}" FontSize="11.5" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SaveFileButton" Content="Save" Width="68" Height="24" Margin="0,0,0,0" Click="SaveFileButton_Click" Background="{StaticResource BrushAccent}" Foreground="#0F1722" BorderBrush="{StaticResource BrushAccent}" FontWeight="SemiBold" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Margin="8" CornerRadius="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Background="#1E1F22">
                <Grid Margin="0">
                    <Border x:Name="LoginView" CornerRadius="10" Background="#252A31" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="20" Margin="12">
                        <StackPanel>
                            <TextBlock Text="Desktop Login" Foreground="{StaticResource BrushText}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0" Text="Authorize from browser and return here." Foreground="#A4B0C0" FontSize="14" />
                            <Button Margin="0,16,0,0" Width="180" Height="40" Click="LoginButton_Click" Content="Login" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Background="{StaticResource BrushAccent}" Foreground="#0F1722" BorderBrush="{StaticResource BrushAccent}" />
                            <TextBlock x:Name="StatusTextBlock" Margin="0,14,0,0" Foreground="#D1D5DB" FontSize="13" Text="Status: Not logged in" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid x:Name="DashboardView" Visibility="Collapsed" Margin="12">
                        <Border CornerRadius="10" Background="#252A31" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Today's Task" Foreground="{StaticResource BrushMuted}" FontSize="12" />
                                    <TextBlock x:Name="RandomTaskTitleText" Text="Task title" Foreground="{StaticResource BrushText}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    <TextBlock x:Name="RandomTaskMetaText" Text="ID | Priority | Estimate | Project" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,8,0,0" />
                                </StackPanel>

                                <Border Grid.Row="1" Margin="0,14,0,0" Padding="10" CornerRadius="6" Background="#1E1F22" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                    <TextBlock x:Name="RandomTaskStatusText" Text="Status: TODO" Foreground="{StaticResource BrushAccent}" FontSize="12" FontWeight="SemiBold" />
                                </Border>

                                <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="RandomTaskDescriptionText"
                                               Text="Task details"
                                               Foreground="{StaticResource BrushText}"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               LineHeight="22" />
                                </ScrollViewer>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="StartTaskButton"
                                            Content="Start Task"
                                            Width="140"
                                            Height="36"
                                            Click="StartTaskButton_Click"
                                            Background="{StaticResource BrushAccent}"
                                            Foreground="#0F1722"
                                            BorderBrush="{StaticResource BrushAccent}"
                                            FontWeight="SemiBold" />
                                    <Button x:Name="SkipTaskButton"
                                            Content="Skip Task"
                                            Width="120"
                                            Height="36"
                                            Margin="10,0,0,0"
                                            Click="SkipTaskButton_Click"
                                            Background="#2C313C"
                                            Foreground="{StaticResource BrushText}"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            FontWeight="SemiBold" />
                                    <TextBlock x:Name="PendingReviewsCountText"
                                               Visibility="Collapsed"
                                               Margin="16,9,0,0"
                                               Text="-"
                                               Foreground="{StaticResource BrushText}"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                    <TextBlock x:Name="VerificationSummaryText"
                                               Margin="10,10,0,0"
                                               Text="Checking..."
                                               Foreground="{StaticResource BrushMuted}"
                                               FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <wv2:WebView2 x:Name="EditorWebView" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="3" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0">
            <StackPanel Margin="8,12,8,12">
                <Border Width="26" Height="26" CornerRadius="13" Background="#2F4054" Margin="0,0,0,8" />
                <Border Width="26" Height="26" CornerRadius="13" Background="#2F4054" Margin="0,0,0,8" />
                <Border Width="26" Height="26" CornerRadius="13" Background="#2F4054" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Background="#181B1F" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,1,0,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="TERMINAL  Local" Foreground="{StaticResource BrushMuted}" FontSize="11" FontWeight="SemiBold" />
                <Border Grid.Row="1" Margin="0,8,0,0" Background="#111317" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <TextBlock Text="$ dotnet watch --no-hot-reload run" FontFamily="Consolas" Foreground="#87D6A9" FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Background="#2A5B66" BorderBrush="#2A5B66" BorderThickness="1,1,0,0" Padding="8,0">
            <DockPanel>
                <TextBlock Text="FreshImpact V3" Foreground="#DFF8FF" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="  |  MERN Editor Mode" Foreground="#C8EAF3" FontSize="11" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="Trial" Foreground="#DFF8FF" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

